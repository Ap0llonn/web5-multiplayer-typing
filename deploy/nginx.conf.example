# Replace example.invalid and certificate paths after approving VPS/domain setup.
server {
  listen 443 ssl;
  server_name example.invalid;
  ssl_certificate /etc/letsencrypt/live/example.invalid/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/example.invalid/privkey.pem;
  client_max_body_size 16k;
  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    # Overwrite, never append an untrusted client header.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_buffering off;
    proxy_read_timeout 75s;
  }
}
