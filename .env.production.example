# Dokploy production template. Replace every CHANGE_ME value in Dokploy's
# environment settings; do not commit real credentials or upload this file.
# DATABASE_URL must point to an external PostgreSQL database reachable by Dokploy.
# For a Dokploy database, copy its Internal Connection URL exactly (host/port/TLS).
# compose.production.yaml joins the existing dokploy-network for internal DNS.
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/CHANGE_ME?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Public HTTPS origin, with no trailing slash. Configure OAuth callbacks against this origin.
BETTER_AUTH_URL=https://CHANGE_ME.example.com

# Required for the checkpoint OAuth providers. Set real credentials in Dokploy.
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME

# Reserved for future application features; Redis and S3 are not currently
# consumed by the application. Provision these externally if/when needed.
REDIS_URL=rediss://CHANGE_ME:CHANGE_ME@CHANGE_ME:6379/0
S3_ENDPOINT=https://CHANGE_ME.example.com
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=CHANGE_ME
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
