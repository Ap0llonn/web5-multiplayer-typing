# LOCAL DEVELOPMENT EXAMPLES ONLY. Never reuse these values in production.
# Compose reads .env (not .env.local). Start: pnpm infra:up
POSTGRES_USER=typing
POSTGRES_PASSWORD=local-postgres-example
POSTGRES_DB=typing_dev
POSTGRES_PORT=5432
# Keep this URL in sync if the PostgreSQL user/password/database/port changes.
# URL-encode special characters in passwords used inside URLs.
DATABASE_URL=postgresql://typing:local-postgres-example@127.0.0.1:5432/typing_dev
# Generate locally: openssl rand -base64 32. Never commit real secrets.
BETTER_AUTH_SECRET=
# Public HTTPS origin in production; http://localhost:3000 for development.
BETTER_AUTH_URL=http://localhost:3000
# Both pairs are mandatory for the checkpoint OAuth acceptance tests.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional infrastructure for future features; not consumed by Next.js yet.
# Redis has authentication and AOF persistence; keep REDIS_URL in sync.
REDIS_PASSWORD=local-redis-example
REDIS_PORT=6379
REDIS_URL=redis://:local-redis-example@127.0.0.1:6379/0

# Local S3-compatible image storage (SeaweedFS); not a real AWS account.
# Credentials and bucket are consumed by Compose. Endpoint/region/path style
# document the future server-side SDK configuration; no upload feature yet.
S3_ACCESS_KEY_ID=local-images-example
S3_SECRET_ACCESS_KEY=local-s3-secret-example
S3_BUCKET=typing-images
S3_REGION=us-east-1
S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_FORCE_PATH_STYLE=true
